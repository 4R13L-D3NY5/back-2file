APP_NAME=SIDOPA
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://documentacion.unitepc.edu.bo
SANCTUM_STATEFUL_DOMAINS=documentacion.unitepc.edu.bo

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_ES

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=error

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=sidopa_documentacion
DB_USERNAME=sidopa_documentacion_user
DB_PASSWORD=change-me

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=documentacion.unitepc.edu.bo

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@unitepc.edu.bo"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

UNIVERSITY_BASE_URL=https://gw-dev.unitepc.solutions/api/v1/university/externals
UNIVERSITY_AUTH_URL=https://sso.unitepc.solutions/auth/token
UNIVERSITY_CLIENT_ID=replace-me
UNIVERSITY_CLIENT_SECRET=replace-me

PROGRAMAS_API_TOKEN=unitepc-programas-2026
